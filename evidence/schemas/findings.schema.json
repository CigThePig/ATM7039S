{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research findings ledger",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "subsystem", "claim", "confidence", "scope", "evidence", "supporting_evidence",
                 "contradictory_evidence", "validation", "hardware_validated", "limitations", "related_findings"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z]+-\\d{3}$"},
      "subsystem": {"type": "string", "minLength": 1},
      "claim": {"type": "string", "minLength": 1},
      "confidence": {"enum": ["verified", "strongly-supported", "inferred", "speculative", "unknown"]},
      "scope": {"type": "string", "minLength": 1},
      "classification": {"type": "string"},
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {"type": "string"},
            "path": {"type": "string"},
            "line_start": {"type": "integer", "minimum": 1},
            "line_end": {"type": "integer", "minimum": 1},
            "artifact": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "offset_start": {"type": "integer", "minimum": 0},
            "offset_end": {"type": "integer", "minimum": 0},
            "section": {"type": "string"},
            "node": {"type": "string"},
            "observation": {"type": "string", "pattern": "^OBS-\\d{3}$"},
            "item": {"type": "string", "description": "capture item id within the observation"}
          }
        }
      },
      "supporting_evidence": {"type": "array", "items": {"type": "string"}},
      "contradictory_evidence": {"type": "array", "items": {"type": "string"}},
      "validation": {"enum": ["static-inspection", "reproducible-static-analysis", "hardware-observation"]},
      "hardware_validated": {"type": "boolean"},
      "observations": {"type": "array", "items": {"type": "string", "pattern": "^OBS-\\d{3}$"}, "minItems": 1},
      "limitations": {"type": "string", "minLength": 1},
      "related_findings": {"type": "array", "items": {"type": "string"}}
    },
    "if": {"properties": {"validation": {"const": "hardware-observation"}}},
    "then": {"required": ["observations"]}
  }
}
