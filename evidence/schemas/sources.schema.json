{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned evidence sources",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "url", "revision", "type", "examined", "license_status", "scope"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
      "url": {"type": "string", "pattern": "^https://"},
      "revision": {"type": "string", "minLength": 1, "description": "Commit, hash, version or 'unpinned web page retrieved DATE'."},
      "type": {"type": "string", "minLength": 1},
      "examined": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "license_status": {"type": "string", "minLength": 1},
      "scope": {"type": "string", "minLength": 1}
    }
  }
}
