{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded contradictions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "issue", "findings", "status", "next_validation"],
    "properties": {
      "id": {"type": "string", "pattern": "^C-[A-Z0-9-]+$"},
      "issue": {"type": "string", "minLength": 1},
      "findings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "status": {"type": "string", "minLength": 1},
      "next_validation": {"type": "string", "minLength": 1},
      "observations": {"type": "array", "items": {"type": "string", "pattern": "^OBS-\\d{3}$"}}
    }
  }
}
