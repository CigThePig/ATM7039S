 "uboot_variant_strap": {
  "component": "stock-20231014 u-boot.uimage payload (offset 0 = VA 0x05000040)",
  "payload_sha256": "f71fa81758d90a87691f7eafed483a6b437503afe25217f6c456ec4c56c92268",
  "probe_function_va": "0x05025e5c",
  "probe_called_from_va": "0x050078bc (after \"begin to check power!\", only when AFI boot_mode != 1; getter 0x050041d4)",
  "observed": [
   "clears vendor gd->flags bits above bit 17 (ubfx r2,r2,#0,#18)",
   "calls GPIO get-value wrapper 0x05021b10 with GPIO 70",
   "GPIO ops slot 0x05021898 reads (0xb01b0008 + 12*(gpio>>5)) and tests bit (gpio&31); GPIO 224-230 are routed to a PMIC register read instead",
   "non-zero: sets gd->flags bit 20 (0x100000) and prints \"-----s500\"; zero: prints \"-----a7039\"",
   "bootargs builder at 0x05004670 appends \"allenS500=1\" when gd->flags bit 20 is set; bit 18 (0x40000) selects androidboot.mode=charger"
  ],
  "gpio": {
   "number": 70,
   "bank": "C",
   "bit": 6,
   "data_register": "0xb01b0020"
  },
  "gpio_init": "GPIO driver init sets CMU_DEVCLKEN0 (0xb01600a0) bit 18 before registering the ops table at VA 0x0508faf4",
  "limitations": "Static dataflow only. Which board revisions pull GPIOC6 high, and whether \"s500\" denotes different silicon or only a different PCB, is not established."
 },
